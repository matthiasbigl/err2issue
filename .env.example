# err2issue configuration. Copy to `.env` and edit.
# Every setting is an environment variable prefixed E2I_. Nothing else is read.
#
# The absolute minimum for a real deployment is: one credential + one destination.
#   E2I_GITHUB_TOKEN=...
#   E2I_GITHUB_REPO=owner/repo
#
# err2issue refuses to start on an unusable configuration rather than accepting
# telemetry it would silently drop. Run with E2I_SINK=dry-run to evaluate the
# pipeline with no credentials at all.

# =========================================================================
# Credentials — choose ONE of the two blocks below
# =========================================================================

# --- Option A: personal access token (simplest; good for one or two repos) --
# Fine-grained PAT needs: Issues (read & write) on each target repository.
# Classic PAT needs: `repo` scope (or `public_repo` for public repos only).
E2I_GITHUB_TOKEN=ghp_replace_me

# --- Option B: GitHub App (recommended for organisations) ------------------
# One App installed on the org can file into every repo it is granted, and its
# rate limit scales with the installation (5,000/hr floor, up to 12,500/hr)
# instead of being a fixed per-user budget.
# App permissions required: Issues (read & write). Nothing else.
#E2I_GITHUB_APP_ID=123456
#E2I_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/err2issue-app.pem
# Or inline the PEM (escape newlines as \n):
#E2I_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
# Optional: pin one installation instead of resolving it per repository.
#E2I_GITHUB_APP_INSTALLATION_ID=98765432

# GitHub Enterprise Server or GHE.com data residency:
#E2I_GITHUB_API_URL=https://ghes.example.com/api/v3
#E2I_GITHUB_API_URL=https://api.SUBDOMAIN.ghe.com

# =========================================================================
# Routing — which repository receives which service's errors
# =========================================================================

# Default destination when no rule matches.
E2I_GITHUB_REPO=owner/repo

# service.name -> owner/repo. Exact matches beat globs; longer globs beat
# shorter ones, so `cart-api` wins over `cart-*`.
#E2I_ROUTE_MAP=checkout-api=acme/checkout,cart-*=acme/cart,*-worker=acme/workers

# Drop errors from services with no destination (true) or fail loudly (false).
#E2I_DROP_UNROUTED=true

# =========================================================================
# Filing behaviour
# =========================================================================

# github   — file directly via REST (default, recommended)
# workflow — fire workflow_dispatch and let a workflow file the issue
# dry-run  — log every action, write nothing
#E2I_SINK=github

#E2I_ISSUE_LABELS=err2issue
#E2I_REOPEN_CLOSED=true
#E2I_MAX_COMMENT_PER_ISSUE_PER_HOUR=4

# Only used when E2I_SINK=workflow:
#E2I_WORKFLOW_FILE=file-error-issue.yml
#E2I_WORKFLOW_REF=main

# =========================================================================
# Noise control
# =========================================================================

# At most one filing per unique error per window, per replica.
#E2I_SUPPRESS_WINDOW_SECONDS=600
# Global ceiling across all errors.
#E2I_MAX_DISPATCHES_PER_MINUTE=30
# Bad-deploy guard: cap on *distinct* new errors per day.
#E2I_MAX_NEW_FINGERPRINTS_PER_DAY=50
# Traces retained for correlated-log lookup.
#E2I_TRACE_BUFFER_SIZE=500

# =========================================================================
# Content limits
# =========================================================================

#E2I_MAX_MESSAGE_CHARS=2000
#E2I_MAX_STACKTRACE_CHARS=6000
#E2I_MAX_CONTEXT_LOG_LINES=20

# =========================================================================
# Redaction — runs before anything is written to GitHub
# =========================================================================

# Issues are public-by-default and permanently archived, so this is on by
# default. Covers GitHub/AWS/Slack/Stripe/Google/Anthropic token shapes, JWTs,
# Authorization headers, connection-string passwords, and PEM key blocks.
#E2I_REDACT=true
# Extra regexes, comma-separated. An invalid pattern fails startup.
#E2I_REDACT_EXTRA_PATTERNS=INTERNAL-[0-9]{6}

# =========================================================================
# AI title and summary — an enhancement, never a dependency
# =========================================================================

# Without a key, filing proceeds with a deterministic title.
#E2I_ANTHROPIC_API_KEY=sk-ant-...
#E2I_AI_ENABLED=true
#E2I_AI_MODEL=claude-opus-5
#E2I_AI_TIMEOUT_SECONDS=20

# =========================================================================
# Ingest
# =========================================================================

#E2I_HOST=0.0.0.0
#E2I_PORT=4318
#E2I_LOG_LEVEL=INFO

# Treat only records carrying `exception.type` as errors, ignoring severity.
#E2I_REQUIRE_EXCEPTION_ATTRIBUTES=false
